# ==============================================================================
# Environment Configuration Template for Local Desktop AI Assistant
# (Contains zero secrets or API keys. Fully local & offline execution)
# ==============================================================================

# Hardware Resource Governor
CPU_THREADS=4
GPU_LAYERS=24
PROCESS_PRIORITY=BELOW_NORMAL
MAX_CONTEXT_TOKENS=2048
MAX_OUTPUT_TOKENS=512
MAX_CONCURRENT_REQUESTS=1
IDLE_TIMEOUT_SECONDS=300
LOW_RESOURCE_MODE=false

# Local Network Isolation Boundaries
ALLOW_EXTERNAL_NETWORKING=false
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# Local Paths
MODEL_PATH=models/Qwen3-1.7B-Q4_K_M.gguf
LLAMA_BIN_DIR=bin/llama.cpp
LOG_DIR=logs
